# Application Secret Key - MUST be changed to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Cookie Security - HTTPS required for Secure cookies
COOKIE_SECURE=true
COOKIE_SAMESITE_NONE=false
COOKIE_SAMESITE_STRICT=true

# Database - SQLite file path (absolute path inside container)
DATABASE_URL=sqlite:////data/kaoyan.db

# Allowed frontend origins (comma-separated, no wildcards)
# Must start with http:// or https://
FRONTEND_ORIGIN=https://your-domain.com

# Flask debug mode - NEVER enable in production
FLASK_DEBUG=0

# Server port
PORT=5000
