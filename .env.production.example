# ============================================================
# Production Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Flask / Backend ---
FLASK_APP=run.py
FLASK_DEBUG=0                      # 0 = disabled (production), 1 = enabled (dev only)
SECRET_KEY=replace_with_a_long_random_string_generate_with_openssl_rand_hex_32
PORT=5000

# --- Database ---
# Use a strong password for production
DATABASE_URL=postgresql://kaoyan:replace_with_strong_password@db:5432/kaoyan_fsrs

# --- Security ---
COOKIE_SECURE=true                 # Set to true when using HTTPS (production)
COOKIE_SAMESITE=Strict             # Strict | Lax | None (use Strict for best CSRF protection)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true

# --- FSRS Algorithm ---
FSRS_MAX_INTERVAL_DAYS=180         # Maximum interval in days (matches exam cycle)

# --- Sync / API Limits ---
SYNC_MAX_CARDS_PER_PAGE=2000
SYNC_MAX_LOGS_PER_PAGE=5000
SYNC_MAX_DAYS_BACK=365
IMPORT_MAX_WORDS=5000

# --- Docker / Deployment ---
# Generate with: openssl rand -hex 32
# Or: python -c "import secrets; print(secrets.token_hex(32))"
